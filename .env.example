# === LLM provider switch ===
LLM_PROVIDER=auto
GEMINI_MODEL=gemini-3.8-flash

# === NVIDIA model options (comma-separated; UI picks one) ===
NVIDIA_MODELS=deepseek-ai/deepseek-v4.1-flash,z-ai/glm-5.3-flash,nvidia/nemotron-3.5-lightning-30b-a3b
NVIDIA_MODEL=z-ai/glm-5.3-flash

# === API keys (Secret Manager on Cloud Run, .env locally) ===
GOOGLE_API_KEY=
NVIDIA_API_KEY=

# === Retrieval params ===
# Calibrated via eval sweep (REPORT §19): 0.70 = the only threshold with
# refusal accuracy 1.0 AND hit@3 1.0 on the gold set.
# Keep these values in sync with api/main.py defaults and infra/main.tf.
TOP_K=3
TEMPERATURE=0.2
RELEVANCE_THRESHOLD=0.70
MAX_TOKENS=768

# === GCP ===
GCS_BUCKET=